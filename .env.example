VITE_APP_NAME=MailFlow Studio
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_DEMO_MODE=true

# Zmienne tylko dla funkcji Netlify. Nigdy nie dodawaj ich do zmiennych VITE_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_ENCRYPTION_KEY=
ADMIN_ALLOWED_ORIGINS=http://localhost:8888,http://localhost:4173
# Publiczne API jest przeznaczone głównie server-to-server. Dodaj origin tylko,
# gdy świadomie wywołujesz je bezpośrednio z zaufanej aplikacji przeglądarkowej.
PUBLIC_API_ALLOWED_ORIGINS=http://localhost:8888,http://localhost:4173
WORKER_SECRET=
INGEST_SIGNING_SECRET=
WEBHOOK_SIGNING_SECRET=
WEBHOOK_ALLOWED_HOSTS=
SCRAPER_ALLOWED_HOSTS=

# Limity pojedynczych przebiegów workerów. Zmniejsz je przy krótkim limicie funkcji.
CONNECTORS_PER_RUN=3
PROCESSING_BATCH_SIZE=50
ORGANIZATIONS_PER_RUN=10
OUTBOUND_BATCH_SIZE=20

# Retencja technicznych logów publicznego API.
API_REQUEST_LOG_RETENTION_DAYS=90
API_RATE_BUCKET_RETENTION_HOURS=24
