{
  "name": "mailflow-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run src",
    "test:backend": "node --test tests/*.test.mjs",
    "test:edge": "cd supabase && npx --yes deno@2.5.6 test tests",
    "test:all": "npm run test && npm run test:backend && npm run test:edge",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:openapi": "npx --yes @redocly/cli@1.34.5 lint public/openapi.yaml --extends=minimal",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:netlify": "find netlify/functions -type f -name '*.mjs' -exec node --check {} \\;",
    "check:edge": "cd supabase && npx --yes deno@2.5.6 check functions/*/index.ts",
    "check": "npm run lint && npm run test:all && npm run check:secrets && npm run check:openapi && npm run check:migrations && npm run check:netlify && npm run check:edge && npm run build",
    "preview": "vite preview",
    "bootstrap-admin": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@netlify/functions": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "imapflow": "^1.7.8",
    "linkedom": "^0.18.14",
    "lucide-react": "^0.577.0",
    "mailparser": "^3.12.4",
    "nodemailer": "^9.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.4",
    "vitest": "^3.0.5"
  }
}
